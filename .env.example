# Copy to .env.local and set your production domain (used for canonical URLs,
# sitemap.xml, robots.txt and Open Graph tags). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Optional, for later: real keyword validation via DataForSEO ---
# These are NOT used by the app yet. When you wire up the validation script,
# read them from here so secrets never live in source control.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
